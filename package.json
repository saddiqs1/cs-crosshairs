{
	"name": "cs-crosshairs",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"db:build": "rimraf distDatabase && tsc --project tsconfig-database.json",
		"db:generate": "dotenv -e .env.local -- kysely-codegen --dialect postgres --out-file ./src/types/generated/database.ts && node scripts/copyFile ./src/types/generated/database.ts ./database/database.ts",
		"db:seed": "npm run db:build && node distDatabase/seed.js",
		"migrate": "npm run db:build && node distDatabase/index.js latest",
		"migrate:fresh": "npm run db:build && node distDatabase/index.js fresh",
		"migrate:up": "npm run db:build && node distDatabase/index.js up",
		"migrate:down": "npm run db:build && node distDatabase/index.js down",
		"migrate:create": "node scripts/createMigration.js",
		"dev:reset-db": "npm run db:build && node distDatabase/index.js fresh && node distDatabase/seed.js",
		"test": "node --test tests/*.test.mjs"
	},
	"dependencies": {
		"@mantine/core": "^9.7.5",
		"@mantine/form": "^9.7.5",
		"@mantine/hooks": "^9.7.5",
		"@mantine/notifications": "^9.7.5",
		"@tabler/icons-react": "^3.50.0",
		"@vercel/postgres": "^0.10.0",
		"csgo-sharecode": "^7.0.1",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.4.5",
		"iron-session": "^9.0.1",
		"kysely": "^0.29.8",
		"next": "^16.4.5",
		"node-steam-openid": "^2.0.0",
		"pg": "^8.23.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"swr": "^2.5.1",
		"typescript": "~6.0.3",
		"zod": "^4.6.7",
		"dotenv": "^18.0.9"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/node-steam-openid": "^1.0.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"chalk": "^6.0.1",
		"dotenv-cli": "^11.1.0",
		"eslint-config-prettier": "^10.1.8",
		"kysely-codegen": "^0.20.0",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.4",
		"@types/pg": "^8.0.0"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"overrides": {
		"@typescript-eslint/typescript-estree": {
			"minimatch": "^11.0.5"
		}
	}
}
